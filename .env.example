# انسخ هذا الملف إلى .env.local (تطوير) أو اضبط القيم في لوحة الاستضافة (إنتاج).
# لا تضع أي قيمة سرية في هذا الملف. راجع docs/SECURITY.md §8.

# ── core ─────────────────────────────────────────────
# الرابط الأساسي للموقع (canonical وفحص Origin)
APP_URL=http://localhost:3000
# يجب أن تكون MongoDB replica set (Atlas أو mongod --replSet) لدعم المعاملات
MONGODB_URI=

# ── security (مطلوبة من المرحلة 4) ───────────────────
# 32 حرفًا عشوائيًا على الأقل: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
# x-forwarded-for على Vercel، x-real-ip خلف Nginx على VPS
TRUSTED_PROXY_HEADER=x-forwarded-for
CRON_SECRET=

# ── cloudinary (مطلوبة من المرحلة 5) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
